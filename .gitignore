node_modules/
dist/

# evo/ run artifacts — per-run, local, regenerated by `npm run evo:run`
evo/work/
evo/observations/*.md
evo/proposals/*.diff
evo/proposals/*.md

# local model cache for Node-side measurement (vendored MiniLM, never committed)
.models/

# form-genres fetch freeze (regenerable source-text cache; the trimmed instances
# + provenance live in form-genres.jsonl, the version of record)
tools/form-genres/cache/*.txt

# WebLLM self-hosting mirror — downloaded artifacts staged for upload (multi-GB,
# regenerable via tools/mirror/webllm-to-r2.mjs)
tools/mirror/out/
tools/mirror/models.json

# Claude Code local session state (settings, agent worktrees)
.claude/
