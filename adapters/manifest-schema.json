{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AdapterManifest",
  "type": "object",
  "required": [
    "id",
    "name",
    "version",
    "category",
    "modality",
    "capability",
    "modelRef",
    "resources",
    "confidenceSemantics",
    "failureModes"
  ],
  "additionalProperties": true,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+" },
    "category": { "type": "string", "enum": ["perceptual", "parsing", "embedding", "generation"] },
    "modality": { "type": "string", "enum": ["image", "audio", "text", "code", "table", "pdf", "image+text", "audio+text"] },
    "capability": { "type": "string", "minLength": 1 },
    "modelRef": {
      "type": "object",
      "required": ["runtime", "model", "version"],
      "additionalProperties": true,
      "properties": {
        "runtime": { "type": "string", "enum": ["transformersjs", "tesseract", "deterministic", "webllm", "external"] },
        "model": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "weightsUrl": { "type": "string" },
        "weightsBytes": { "type": "number", "minimum": 0 }
      }
    },
    "resources": {
      "type": "object",
      "required": ["backend", "memMB", "expectedLatencyMs"],
      "additionalProperties": true,
      "properties": {
        "backend": { "type": "string", "enum": ["cpu", "webgpu", "wasm"] },
        "memMB": { "type": "number", "minimum": 0 },
        "expectedLatencyMs": { "type": "number", "minimum": 0 }
      }
    },
    "confidenceSemantics": { "type": "string", "enum": ["softmax", "model-head", "heuristic", "deterministic"] },
    "failureModes": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "input": { "type": "object" },
    "output": { "type": "object" },
    "meta": { "type": "object" },
    "defaultForCapability": { "type": "boolean" }
  }
}
