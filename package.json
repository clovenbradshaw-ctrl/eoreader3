{
  "name": "cleon-engine-tests",
  "version": "1.0.0",
  "private": true,
  "description": "Dev-only test/benchmark harness for the Cleon reading engine. The app itself is a no-build static site (see index.html); this exists only so the deterministic engine can be exercised and timed from Node.",
  "scripts": {
    "test": "node tests/engine.test.js && node tests/learning.test.js && node tests/audit.test.js && node tests/llm.test.js && node tests/parity.js",
    "test:update": "node tests/parity.js --update",
    "bench": "node tests/bench.js",
    "demo": "node tests/demo-learning.js",
    "build": "node build.mjs",
    "evo:run": "node evo/runner.js",
    "evo:review": "node evo/runner.js --review",
    "evo:accept": "node evo/runner.js --accept",
    "evo:reject": "node evo/runner.js --reject",
    "evo:score": "node evo/scorer.js",
    "evo:sandbox": "node evo/build-sandbox-data.js && node evo/build-sandbox.mjs",
    "evo:sandbox-data": "node evo/build-sandbox-data.js",
    "evo:sandbox-build": "node evo/build-sandbox.mjs",
    "evo:experiment": "node evo/experiments/graph-queryability.js",
    "evo:prompts": "node evo/experiments/prompt-audit.js",
    "evo:questions": "node evo/experiments/question-probe.js",
    "evo:ingestion": "node evo/experiments/ingestion-quality.js"
  },
  "devDependencies": {
    "compromise": "^14.14.0",
    "esbuild": "^0.24.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
